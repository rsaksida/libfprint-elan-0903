+#define FPI_PRINT_IMAGES_TYPE G_VARIANT_TYPE ("a(iiay)")
+/* how far apart, in pixels, two presses of the same finger may land */
+#define IMAGE_MATCH_MAX_SHIFT 20
+#define IMAGE_MATCH_SHIFT_STEP 2
+#define IMAGE_MATCH_SAMPLE_STEP 2
+
+/**
+ * fpi_print_add_image:
+ * @print: A #FpPrint of type #FPI_PRINT_RAW
+ * @image: The image to append
+ *
+ * Appends the pixels of @image to the images stored in @print.
+ */
+void
+fpi_print_add_image (FpPrint *print,
+                     FpImage *image)
+{
+  GVariantBuilder builder = G_VARIANT_BUILDER_INIT (FPI_PRINT_IMAGES_TYPE);
+  GVariant *pixels;
+
+  g_return_if_fail (print->type == FPI_PRINT_RAW);
+
+  if (print->data)
+    {
+      GVariantIter iter;
+      GVariant *child;
+
+      g_variant_iter_init (&iter, print->data);
+      while ((child = g_variant_iter_next_value (&iter)))
+        {
+          g_variant_builder_add_value (&builder, child);
+          g_variant_unref (child);
+        }
+    }
+
+  pixels = g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, image->data,
+                                      image->width * image->height, 1);
+  g_variant_builder_add (&builder, "(ii@ay)", image->width, image->height, pixels);
+
+  g_clear_pointer (&print->data, g_variant_unref);
+  print->data = g_variant_ref_sink (g_variant_builder_end (&builder));
+}
+
+static gdouble
+image_best_correlation (const guint8 *a, const guint8 *b, gint w, gint h)
+{
+  gdouble best = -1;
+
+  for (gint dy = -IMAGE_MATCH_MAX_SHIFT; dy <= IMAGE_MATCH_MAX_SHIFT; dy += IMAGE_MATCH_SHIFT_STEP)
+    for (gint dx = -IMAGE_MATCH_MAX_SHIFT; dx <= IMAGE_MATCH_MAX_SHIFT; dx += IMAGE_MATCH_SHIFT_STEP)
+      {
+        gdouble sum_a = 0, sum_b = 0, sum_aa = 0, sum_bb = 0, sum_ab = 0;
+        gdouble cov, var_a, var_b;
+        gint n = 0;
+
+        for (gint y = MAX (0, -dy); y < MIN (h, h - dy); y += IMAGE_MATCH_SAMPLE_STEP)
+          for (gint x = MAX (0, -dx); x < MIN (w, w - dx); x += IMAGE_MATCH_SAMPLE_STEP)
+            {
+              gdouble pa = a[y * w + x];
+              gdouble pb = b[(y + dy) * w + x + dx];
+
+              sum_a += pa;
+              sum_b += pb;
+              sum_aa += pa * pa;
+              sum_bb += pb * pb;
+              sum_ab += pa * pb;
+              n++;
+            }
+
+        cov = sum_ab - sum_a * sum_b / n;
+        var_a = sum_aa - sum_a * sum_a / n;
+        var_b = sum_bb - sum_b * sum_b / n;
+
+        if (var_a > 0 && var_b > 0)
+          best = MAX (best, cov / sqrt (var_a * var_b));
+      }
+
+  return best;
+}
+
+/**
+ * fpi_print_image_match:
+ * @print_template: A #FpPrint of type #FPI_PRINT_RAW holding the enrolled images
+ * @print: A #FpPrint of type #FPI_PRINT_RAW holding the image to check
+ * @threshold: The correlation needed for a match
+ * @error: Return location for error
+ *
+ * Compares the image in @print to each enrolled image, allowing for the finger
+ * landing in a slightly different place.
+ *
+ * Returns: Whether the prints match, %FPI_MATCH_ERROR on failure
+ */
+FpiMatchResult
+fpi_print_image_match (FpPrint *print_template,
+                       FpPrint *print,
+                       gdouble  threshold,
+                       GError **error)
+{
+  g_autoptr(GVariant) probe = NULL;
+  g_autoptr(GVariant) probe_pixels = NULL;
+  const guint8 *probe_data;
+  gsize probe_len;
+  gint width, height;
+  gdouble best = -1;
+  GVariantIter iter;
+  GVariant *child;
+
+  if (print_template->type != FPI_PRINT_RAW || print->type != FPI_PRINT_RAW ||
+      !print_template->data || !print->data ||
+      !g_variant_is_of_type (print_template->data, FPI_PRINT_IMAGES_TYPE) ||
+      g_variant_n_children (print->data) != 1)
+    {
+      *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_INVALID,
+                                         "Prints do not hold comparable images");
+      return FPI_MATCH_ERROR;
+    }
+
+  probe = g_variant_get_child_value (print->data, 0);
+  g_variant_get (probe, "(ii@ay)", &width, &height, &probe_pixels);
+  probe_data = g_variant_get_fixed_array (probe_pixels, &probe_len, 1);
+
+  g_variant_iter_init (&iter, print_template->data);
+  while ((child = g_variant_iter_next_value (&iter)))
+    {
+      g_autoptr(GVariant) pixels = NULL;
+      const guint8 *data;
+      gsize len;
+      gint w, h;
+
+      g_variant_get (child, "(ii@ay)", &w, &h, &pixels);
+      data = g_variant_get_fixed_array (pixels, &len, 1);
+
+      if (w == width && h == height && len == probe_len &&
+          len == (gsize) (width * height))
+        best = MAX (best, image_best_correlation (probe_data, data, w, h));
+
+      g_variant_unref (child);
+    }
+
+  fp_dbg ("image match score %.3f, threshold %.3f", best, threshold);
+
+  return best >= threshold ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL;
+}
