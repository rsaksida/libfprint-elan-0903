+/**
+ * fpi_image_device_set_image_match_threshold:
+ * @self: a #FpImageDevice imaging fingerprint device
+ * @threshold: Normalized correlation needed for a match, in the range (0, 1]
+ *
+ * Makes the device compare images directly rather than minutiae. This is for
+ * sensors whose images are too small to contain enough minutiae to match.
+ */
+void
+fpi_image_device_set_image_match_threshold (FpImageDevice *self,
+                                            gdouble        threshold)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+
+  g_return_if_fail (FP_IS_IMAGE_DEVICE (self));
+  g_return_if_fail (threshold > 0 && threshold <= 1);
+
+  priv->image_match_threshold = threshold;
+}
