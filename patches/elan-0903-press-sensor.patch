+static void
+elan_submit_press_image (FpImageDevice *dev)
+{
+  FpiDeviceElan *self = FPI_DEVICE_ELAN (dev);
+  static int press_idx = 0;
+  int width = self->frame_width;
+  int height = self->frame_height;
+  int size = width * height;
+  unsigned short *best = NULL;
+  guint64 best_sharpness = 0;
+  int best_empty = 100;
+  GSList *frames = NULL;
+  GSList *l;
+  FpImage *img;
+
+  G_DEBUG_HERE ();
+
+  press_idx++;
+
+  /* the newest frames are first and may be blurred by the finger lifting */
+  for (l = g_slist_nth (self->frames, ELAN_SKIP_LAST_FRAMES); l; l = l->next)
+    {
+      unsigned short *frame = l->data;
+      guint64 sharpness = 0;
+      int zeros = 0;
+      int empty;
+
+      for (int i = 0; i < size; i++)
+        {
+          if (frame[i] == 0)
+            zeros++;
+          if ((i + 1) % width != 0)
+            sharpness += ABS (frame[i + 1] - frame[i]);
+        }
+
+      empty = zeros * 100 / size;
+      if (empty < best_empty && best_empty > ELAN_PRESS_MAX_EMPTY)
+        {
+          best = frame;
+          best_empty = empty;
+          best_sharpness = sharpness;
+        }
+      else if (empty <= ELAN_PRESS_MAX_EMPTY && sharpness > best_sharpness)
+        {
+          best = frame;
+          best_empty = empty;
+          best_sharpness = sharpness;
+        }
+    }
+
+  fp_dbg ("press %d: %d frames, best empty %d%%, sharpness %" G_GUINT64_FORMAT,
+          press_idx, self->num_frames, best_empty, best_sharpness);
+
+  if (!best || best_empty > ELAN_PRESS_MAX_EMPTY)
+    {
+      fpi_image_device_retry_scan (dev, FP_DEVICE_RETRY_CENTER_FINGER);
+      return;
+    }
+
+  assembling_ctx.frame_width = width;
+  assembling_ctx.frame_height = height;
+  self->process_frame (best, &frames);
+
+  img = fp_image_new (width, height);
+  memcpy (img->data, ((struct fpi_frame *) frames->data)->data, size);
+  img->flags |= FPI_IMAGE_PARTIAL;
+  g_slist_free_full (frames, g_free);
+
+  fpi_image_device_image_captured (dev, img);
+}
